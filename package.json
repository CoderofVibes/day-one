{
  "name": "day-one",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "agents/kevin",
    "agents/suppliers",
    "web",
    "erp"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "tsx server/src/seed/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "verify": "tsx scripts/verify.ts",
    "render:records": "tsx tools/render/src/render.ts",
    "bakeoff": "tsx scripts/bakeoff.ts",
    "test:attacks": "tsx scripts/attacks.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:live": "tsx scripts/demo.ts --live",
    "rehearse": "tsx scripts/rehearse.ts",
    "escrow": "tsx scripts/escrow.ts",
    "web": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:data": "tsx scripts/web-data.ts",
    "web:shot": "tsx tools/render/src/shot.ts",
    "erp": "tsx erp/src/server.ts",
    "erp:seed": "tsx scripts/erp-seed.ts",
    "erp:demo": "tsx scripts/erp-demo.ts",
    "erp:reconcile": "tsx scripts/erp-reconcile.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
