{
  "name": "day-one",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "agents/kevin",
    "agents/suppliers",
    "api",
    "web",
    "erp"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "tsx server/src/seed/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "reset:testnet": "tsx scripts/reset-testnet.ts",
    "verify": "tsx scripts/verify.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "repo:check": "tsx scripts/repo-check.ts",
    "attest": "tsx scripts/attest.ts",
    "verify:attestation": "tsx scripts/verify-attestation.ts",
    "verify:round": "tsx scripts/verify-round.ts",
    "sealed": "tsx scripts/sealed.ts",
    "render:records": "tsx tools/render/src/render.ts",
    "bakeoff": "tsx scripts/bakeoff.ts",
    "test:attacks": "tsx scripts/attacks.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:live": "tsx scripts/demo.ts --live",
    "demo:group": "tsx scripts/demo-group.ts",
    "rehearse": "tsx scripts/rehearse.ts",
    "preflight": "tsx scripts/preflight.ts",
    "record:credentials": "tsx scripts/record-credential-attacks.ts",
    "escrow": "tsx scripts/escrow.ts",
    "policy": "tsx scripts/policy-change.ts",
    "mcp": "tsx scripts/kevin-mcp.ts",
    "books": "tsx scripts/books.ts",
    "inbox": "tsx scripts/inbox.ts",
    "brief": "tsx scripts/brief.ts",
    "import": "tsx scripts/import.ts",
    "render:import": "tsx scripts/render-import.ts",
    "api": "tsx api/src/main.ts",
    "api:live": "tsx api/src/main.ts --live",
    "web": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:data": "tsx scripts/web-data.ts",
    "web:shot": "tsx tools/render/src/shot.ts",
    "web:shot:3d": "tsx tools/render/src/shot3d.ts",
    "host:build": "tsx scripts/host-build.ts",
    "erp": "tsx erp/src/server.ts",
    "erp:seed": "tsx scripts/erp-seed.ts",
    "erp:demo": "tsx scripts/erp-demo.ts",
    "erp:reconcile": "tsx scripts/erp-reconcile.ts",
    "usdc": "tsx scripts/usdc.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
