{
  "name": "day-one",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "agents/kevin",
    "agents/suppliers",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "seed": "tsx server/src/seed/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup:testnet": "tsx scripts/setup-testnet.ts",
    "deploy:testnet": "tsx scripts/deploy.ts",
    "verify": "tsx scripts/verify.ts",
    "render:records": "tsx tools/render/src/render.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
