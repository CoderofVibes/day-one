# Day One — environment variables for LIVE mode only.
# Replay mode (npm run demo) needs none of these.
# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Mode ---
DAYONE_MODE=replay                 # replay | live
DAYONE_DEMO_CLOCK=2026-11-09T13:00:00Z

# --- NEAR network ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_RPC_FALLBACK_URL=https://near-testnet.drpc.org
NEAR_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/

# --- Accounts (public ids; the full list is committed in config/testnet-accounts.json) ---
NEAR_ROOT_ACCOUNT=acme-holdings.testnet
NEAR_SPEND_POLICY_ACCOUNT=spend-policy.acme-holdings.testnet
NEAR_RELAYER_ACCOUNT=dayone-relayer.testnet

# --- Token ---
# DTUSD (deployed by npm run deploy:testnet). Circle testnet USDC, for the bonus run: 3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
NEAR_TOKEN_ACCOUNT=dtusd.acme-holdings.testnet
NEAR_USDC_PROOF_SPEND_POLICY_ACCOUNT=spend-policy-usdc.acme-holdings.testnet

# --- Keys (ed25519:... secret keys; function-call keys except the relayer and suppliers) ---
KEVIN_FC_KEY=
DIRECTOR_FC_KEY=
RECEIVING_FC_KEY=
QC_FC_KEY=
RELAYER_KEY=
SUPPLIER_NORTHGATE_KEY=
SUPPLIER_RIDGEWAY_KEY=
SUPPLIER_QUICKCHEM_KEY=
SUPPLIER_BAYFRONT_KEY=
# Setup and deploy scripts read full-access keys for acme-holdings and contract
# accounts from the local near-cli credentials directory, not from this file.

# --- LLM ---
LLM_ROUTE_REASONING=nearai:z-ai/glm-5.3-flash
LLM_ROUTE_VISION=nearai:z-ai/glm-5.3-flash     # or anthropic:claude-sonnet-5-5 after the Nov 2 bake-off
LLM_ROUTE_FALLBACK=anthropic:claude-sonnet-5-5  # Talk to Kevin when NEAR AI Cloud fails; labeled "not attested"
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_RECORD_FIXTURES=false

# --- Server ---
PORT=8787
DATABASE_PATH=data/dayone.db
